# Free Groq API key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# If using Ollama locally instead of Groq, leave GROQ_API_KEY empty and set:
LLM_PROVIDER=groq        # options: groq | ollama
OLLAMA_BASE_URL=http://localhost:11434

# MLflow tracking. Defaults to a local file store (./mlruns) — no server needed.
# When running the full docker-compose stack, this is overridden automatically
# to point at the mlflow service.
MLFLOW_TRACKING_URI=file:./mlruns

# Vector store location
CHROMA_PERSIST_DIR=./data/processed/chroma_store
